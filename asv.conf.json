{
    // asv configuration for benchmarking Stingray across its history.
    // See docs/technical_details.md for the rationale behind the "eras".
    "version": 1,
    "project": "stingray",
    "project_url": "https://docs.stingray.science/",
    "repo": "https://github.com/StingraySoftware/stingray.git",
    "branches": ["main"],
    "show_commit_url": "https://github.com/StingraySoftware/stingray/commit/",

    // Environments are built from conda-forge with micromamba. asv must be
    // run with CONDA_EXE pointing to tools/conda-shim (see README.md).
    "environment_type": "conda",
    "conda_channels": ["conda-forge"],
    "conda_environment_file": "IGNORE",

    // Dependencies come only from the pinned conda packages below;
    // --no-deps prevents pip from silently upgrading them.
    "build_command": [],
    "install_command": ["in-dir={build_dir} python -m pip install --no-deps ."],
    "uninstall_command": ["return-code=any python -m pip uninstall -y {project}"],
    "install_timeout": 1200,

    "benchmark_dir": "benchmarks",
    "env_dir": "env",
    "results_dir": "results",
    "html_dir": "html",

    // One environment per era. The exclude removes the default environment
    // (current Python, no pins); includes are added after excludes.
    "exclude": [{"python": ".*"}],
    "include": [
        // Era A: v0.3 -> v1.0
        {"python": "3.8", "req": {"numpy": "1.20", "scipy": "1.6", "astropy": "4.2", "matplotlib-base": "3.3", "numba": "0.53", "six": "", "setuptools": "", "setuptools_scm": "", "wheel": ""}},
        // Era B: v1.0 -> v2.0.0
        {"python": "3.10", "req": {"numpy": "1.26", "scipy": "1.11", "astropy": "5.3", "matplotlib-base": "3.8", "numba": "0.58", "setuptools": "", "setuptools_scm": "", "wheel": ""}},
        // Era C: v2.0.0 -> main
        {"python": "3.12", "req": {"numpy": "2.3", "scipy": "1.16", "astropy": "7.1", "matplotlib-base": "3.10", "numba": "0.62", "setuptools": "", "setuptools_scm": "", "wheel": ""}}
    ]
}
